<%# B1: overrides core app/views/common/_hreflang_tags.html.erb (core ca040eb9, 2026.11.0-latest.2). %>
<%# A topic page declares only its translated languages (TerrytrillaSeo::Hreflang). %>
<%# Every other page — and the whole forum while the plugin is off — renders core's markup, %>
<%# copied below unchanged. On a core upgrade compare it with core's file (README). %>
<% if ContentLocalization.crawler_locale_param_enabled? %>
  <% hreflang_topic = controller.is_a?(TopicsController) && controller.action_name == "show" ? @topic_view&.topic : nil %>
  <% if hreflang_topic && TerrytrillaSeo::Hreflang.active? %>
    <%# B1-бис: основа альтернатив — canonical страницы. У адреса с номером поста
        (/t/тема/51/1) canonical ведёт на /51, и альтернативы обязаны вести туда же. %>
    <% hreflang_base = TerrytrillaSeo::Hreflang.canonical_base(@canonical_url, "#{Discourse.base_url}#{request.path}") %>
    <% TerrytrillaSeo::Hreflang.links(hreflang_topic, hreflang_base).each do |hreflang, href| %>
      <link rel="alternate" href="<%= href %>" hreflang="<%= hreflang %>" />
    <% end %>
  <% else %>
    <% locales = SiteSetting.content_localization_supported_locales&.split('|') || [] %>
    <% if locales.any? %>
      <% plain_url = plain_url_serves_default_locale? %>
      <% locales = SiteSetting.content_localization_locales if plain_url %>
      <link rel="alternate" href="<%= canonical_url_for_locale(nil) %>" hreflang="x-default" />
      <% locales.each do |locale| %>
        <% href_locale = locale unless plain_url && locale == SiteSetting.default_locale %>
        <link rel="alternate" href="<%= canonical_url_for_locale(href_locale) %>" hreflang="<%= locale.tr('_', '-') %>" />
      <% end %>
    <% end %>
  <% end %>
<% end %>
